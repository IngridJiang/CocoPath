# ============================================================
# Maven build artifacts
# ============================================================
**/target/
dependency-reduced-pom.xml

# Compiled class files (outside target/)
*.class

# ============================================================
# Generated CoCoPath exploration outputs
# (produced by run-symbolic-execution-adapted scripts)
# ============================================================

# Model output directories for all modes
knarr-runtime/galette-output-*/

# Path exploration result JSON files
knarr-runtime/execution_paths*.json

# Classpath file written by mvn dependency:build-classpath for 
# knarr and others
**/cp.txt

# pom.xml backup created by switch-dependency.py during mode switch
knarr-runtime/pom.xml.bak

# ============================================================
# Claude Code local settings (machine-specific, not project config)
# ============================================================
.claude/

# ============================================================
# Xtend/Xtext compiler trace files
# ============================================================
**/*._trace

# ============================================================
# IDE and editor files
# ============================================================
.idea/
**/*.iml
.eclipse/
.settings/
.classpath
.project
.vscode/

# ============================================================
# Editor temp files
# ============================================================
**/*.swp
*~

# ============================================================
# OS-generated files
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Misc
# ============================================================
*.log
*.ctxt
*.jar
*.war
*.nar
*.ear
hs_err_pid*
changes.txt
lastClass.txt

# Keep .gitignore files themselves tracked
!**/.gitignore

